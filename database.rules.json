{
  "rules": {
    "rooms": {
      "$roomId": {
        // Room exists validation
        ".read": true,

        // Room creation and updates
        ".write": "!data.exists() || (data.exists() && newData.exists())",

        // Validate room structure
        ".validate": "newData.hasChildren(['settings', 'gameState', 'players'])",
        "settings": {
          ".validate": "newData.hasChildren(['wordLength', 'language', 'isPublic'])",
          "wordLength": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 6"
          },
          "language": {
            ".validate": "newData.isString() && (newData.val() === 'en' || newData.val() === 'he')"
          },
          "isPublic": {
            ".validate": "newData.isBoolean()"
          }
        },

        "id": {
          ".validate": "newData.isString() && newData.val() === $roomId"
        },

        "currentWord": {
          ".validate": "newData.isString() || !newData.exists()"
        },

        "currentSuggester": {
          ".validate": "newData.isString() || !newData.exists()"
        },

        "gameState": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
        },

        "startTime": {
          ".validate": "newData.isNumber()"
        },

        "wordQueue": {
          ".validate": "newData.isString() || !newData.exists()"
        },

        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'username', 'score', 'status'])",

            "id": {
              ".validate": "newData.isString() && newData.val() === $playerId"
            },

            "username": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },

            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "status": {
              ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'won' || newData.val() === 'lost')"
            },

            "guesses": {
              ".validate": "(newData.isString() && newData.val().length <= 500) || !newData.exists()"
            },

            "timeTaken": {
              ".validate": "newData.isNumber() || !newData.exists()"
            },

            "endTime": {
              ".validate": "newData.isNumber() || !newData.exists()"
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        // Users can only read and write their own data
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['uid', 'username', 'createdAt', 'stats', 'gameHistory', 'achievements'])",

        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 15"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "stats": {
            // Further validation can be added here for each stat if needed
           ".validate": "newData.hasChildren(['totalGames', 'totalWins', 'totalLosses', 'avgGuesses', 'avgTime', 'currentStreak', 'maxStreak'])"
        }
        // gameHistory and achievements are less critical to validate deeply for now
      }
    }
  }
}
